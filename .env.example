# CodeForge environment configuration
# Copy to backend/.env and adjust. All variables use the CODEFORGE_ prefix.

# --- AI provider --------------------------------------------------------
# mock   = deterministic offline mode (no key, no network) — the default
# openai = any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LM Studio)
CODEFORGE_LLM_PROVIDER=mock
CODEFORGE_LLM_BASE_URL=https://api.openai.com/v1
CODEFORGE_LLM_MODEL=gpt-4o-mini
CODEFORGE_LLM_API_KEY=
CODEFORGE_LLM_TIMEOUT_SECONDS=60

# --- Storage ------------------------------------------------------------
CODEFORGE_SQLITE_PATH=backend/codeforge.db

# --- Application --------------------------------------------------------
CODEFORGE_ENVIRONMENT=development
CODEFORGE_LOG_LEVEL=INFO

# --- Scanning / indexing limits ----------------------------------------
CODEFORGE_MAX_INDEX_FILE_SIZE_BYTES=2097152
CODEFORGE_MAX_REPOSITORY_FILES=20000

# --- Agent / tools ------------------------------------------------------
CODEFORGE_AGENT_MAX_ITERATIONS=12
CODEFORGE_TOOL_TIMEOUT_SECONDS=60
CODEFORGE_COMMAND_TIMEOUT_SECONDS=300
CODEFORGE_MAX_TOOL_OUTPUT_BYTES=200000

# --- Retrieval / context ------------------------------------------------
CODEFORGE_CONTEXT_BUDGET_TOKENS=8000
CODEFORGE_RETRIEVAL_MAX_CANDIDATES=50

# --- Feature flags --------------------------------------------------------
CODEFORGE_EVAL_ON=true
