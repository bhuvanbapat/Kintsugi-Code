# Kintsugi-Code environment configuration
# Copy to backend/.env and adjust. All variables use the Kintsugi-Code_ prefix.

# --- AI provider --------------------------------------------------------
# mock   = deterministic offline mode (no key, no network) — the default
# openai = any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LM Studio)
Kintsugi-Code_LLM_PROVIDER=mock
Kintsugi-Code_LLM_BASE_URL=https://api.openai.com/v1
Kintsugi-Code_LLM_MODEL=gpt-4o-mini
Kintsugi-Code_LLM_API_KEY=
Kintsugi-Code_LLM_TIMEOUT_SECONDS=60

# --- Storage ------------------------------------------------------------
Kintsugi-Code_SQLITE_PATH=backend/Kintsugi-Code.db

# --- Application --------------------------------------------------------
Kintsugi-Code_ENVIRONMENT=development
Kintsugi-Code_LOG_LEVEL=INFO

# --- Scanning / indexing limits ----------------------------------------
Kintsugi-Code_MAX_INDEX_FILE_SIZE_BYTES=2097152
Kintsugi-Code_MAX_REPOSITORY_FILES=20000

# --- Agent / tools ------------------------------------------------------
Kintsugi-Code_AGENT_MAX_ITERATIONS=12
Kintsugi-Code_TOOL_TIMEOUT_SECONDS=60
Kintsugi-Code_COMMAND_TIMEOUT_SECONDS=300
Kintsugi-Code_MAX_TOOL_OUTPUT_BYTES=200000

# --- Retrieval / context ------------------------------------------------
Kintsugi-Code_CONTEXT_BUDGET_TOKENS=8000
Kintsugi-Code_RETRIEVAL_MAX_CANDIDATES=50

# --- Feature flags --------------------------------------------------------
Kintsugi-Code_EVAL_ON=true

